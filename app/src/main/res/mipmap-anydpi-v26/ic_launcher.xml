<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive only: minSdk is 26, where every launcher masks this itself, so no PNG set
     is needed. The monochrome layer is what Android 13+ tints for a themed icon; the
     foreground is white line work, so it serves as both. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
