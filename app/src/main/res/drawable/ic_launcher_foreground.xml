<?xml version="1.0" encoding="utf-8"?>
<!-- A 2×2 grid of map tiles with a route through them. Everything sits inside the
     66 dp safe circle of the 108 dp canvas, so no launcher mask cuts it. Plain paths
     only, so it draws the same on every API 26+ launcher and as a monochrome layer. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Four rounded tiles, 18 dp each with a 6 dp gap, spanning 33–75: the corners sit
         30 dp from the centre, inside the 33 dp safe radius. -->
    <path
        android:pathData="M36,33 h12 a3,3 0 0 1 3,3 v12 a3,3 0 0 1 -3,3 h-12 a3,3 0 0 1 -3,-3 v-12 a3,3 0 0 1 3,-3 z M60,33 h12 a3,3 0 0 1 3,3 v12 a3,3 0 0 1 -3,3 h-12 a3,3 0 0 1 -3,-3 v-12 a3,3 0 0 1 3,-3 z M36,57 h12 a3,3 0 0 1 3,3 v12 a3,3 0 0 1 -3,3 h-12 a3,3 0 0 1 -3,-3 v-12 a3,3 0 0 1 3,-3 z M60,57 h12 a3,3 0 0 1 3,3 v12 a3,3 0 0 1 -3,3 h-12 a3,3 0 0 1 -3,-3 v-12 a3,3 0 0 1 3,-3 z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <!-- The route: from the lower-left tile, through the centre, to the upper-right one. -->
    <path
        android:pathData="M39,69 C39,58 47,54 54,54 C61,54 69,50 69,39"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
